{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"./src/**/*.{js,jsx,ts,tsx}\"",
    "debug": "node --inspect=0.0.0.0:9229 node_modules/next/dist/bin/next",
    "export": "next-sitemap --config sitemap.config.js && npx vercel --prod",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:static": "npm run build && npm run start & sleep 5 && playwright test && pkill -f 'next start'",
    "test:dev": "npm run dev & sleep 10 && playwright test && pkill -f 'next dev'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "next-sitemap": "^4.2.3",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vercel": "^54.18.6"
  }
}
